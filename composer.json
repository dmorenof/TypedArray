{
  "name": "typedarray/typedarray",
  "description": "Runtime-validated typed collections for PHP 8+, including scalar values, arrays, and class instances.",
  "type": "library",
  "keywords": [
    "typed-array",
    "typed-collection",
    "type-safety",
    "arrayobject",
    "php8",
    "sdk"
  ],
  "homepage": "https://github.com/dmorenof/TypedArray",
  "license": "MIT",
  "authors": [
    {
      "name": "David Moreno Falero",
      "email": "david.moreno.falero@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/dmorenof/TypedArray/issues",
    "source": "https://github.com/dmorenof/TypedArray"
  },
  "require": {
    "php": ">=8.0",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "TypedArray\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.5 || ^13.0"
  },
  "autoload-dev": {
    "psr-4": {
      "TypedArray\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  }
}
