{
  "name": "typedarray/typedarray",
  "description": "Typed arrays for PHP: lists and maps that only accept one type, or a union of types.",
  "type": "library",
  "license": "MIT",
  "keywords": ["array", "typed", "typed-array", "collection", "union-types"],
  "authors": [
    {
      "name": "David Moreno Falero",
      "email": "david.moreno.falero@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "TypedArray\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TypedArray\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  }
}
